#!/bin/sh
bold='[1m'
black='[30m'
red='[31m'
green='[32m'
yellow='[33m'
blue='[34m'
magenta='[35m'
cyan='[36m'
white='[37m'
grey='[90m'
reset='[0m'

lc="${reset}${cyan}"  # labels
nc="${reset}${magenta}"   # user
hn="${reset}${magenta}"     # hostname
ic="${reset}${white}"           # info
c0="${reset}${grey}"            # first color
c1="${reset}${white}"           # second color
c2="${reset}${yellow}"          # third color
c11='[31m'; c12='[32m'
c3='[33m'; c4='[34m'
c5='[35m'; c6='[36m'
c7='[37m'; c8='[38m'
palette="[7m$c11 $c11 $c12 $c12 $c3 $c3 $c4 $c4 $c5 $c5 $c6 $c6 [m"
RED='[0;31m'
GREEN='[0;32m'
YELLOW='[0;33m'
BLUE='[0;34m'
MAGENTA='[0;35m'
CYAN='[0;36m'
NC='[0m'
BLACK='[0;30m'
WHITE='[0;37m'
palette="${BLACK} ${RED} ${GREEN} ${YELLOW} ${BLUE} ${MAGENTA} ${CYAN} ${WHITE} ${NC}"

uptime_fmt() {
  boot=$(sysctl -n kern.boottime | awk '{print $4}' | tr -d ',')
  now=$(date +%s)
  diff=$((now - boot))
  days=$((diff / 86400))
  hours=$(( (diff % 86400) / 3600 ))
  [ $days -gt 0 ] && echo "${days}d ${hours}h" || echo "${hours}h"
}

macos_name() {
  case $(sw_vers -productVersion | cut -d. -f1) in
    15) echo sequoia ;;
    14) echo sonoma ;;
    13) echo ventura ;;
    12) echo monterey ;;
    11) echo "big sur" ;;
    *) sw_vers -productVersion ;;
  esac
}

wm_name() {
  if pgrep -x AeroSpace > /dev/null 2>&1 || pgrep -x aerospace > /dev/null 2>&1; then
    echo aerospace
  elif pgrep -x yabai > /dev/null 2>&1; then
    echo yabai
  else
    echo unknown
  fi
}

cat <<EOF

${c0}   ${nc}            $(tput bold)${USER}$(tput sgr0)${white}@${reset}${hn}$(tput bold)$(hostname)${reset} 
${c0}  ${nc}${reset}
${c0}    ${white}           ${red}$(tput bold)wm    ${ic}$(wm_name)${reset}
${c0}   ${white}(\ /)    ${blue}   $(tput bold)os    ${ic}macos $(macos_name)${reset}
${c0}   ${white}( . .)    ${green}  $(tput bold)up    ${ic}$(uptime_fmt)${reset}
${c0}   ${white}c(${red}"${white})(${red}"${white})${yellow}     $(tput bold)sh    ${ic}$(echo $SHELL | rev | cut -d'/' -f1 | rev)${reset}
${c2}  ${reset}
${c2}               ${palette}

EOF
